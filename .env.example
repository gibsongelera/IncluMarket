# =============================================================================
# IncluMarket — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored; never commit real credentials.
#
#   NEXT_PUBLIC_*  is INLINED INTO THE BROWSER BUNDLE and is readable by every
#                  visitor. Everything WITHOUT that prefix stays on the server.
#
# Never put a secret behind a NEXT_PUBLIC_ prefix. Renaming a secret to add
# that prefix publishes it on the next deploy.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# PUBLIC — safe to expose. The publishable key only grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET — bypasses Row Level Security entirely. Server actions, route handlers
# and scripts/ only. lib/supabase/admin.ts guards this with `server-only` so the
# build fails if it is ever imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me...server-only

# There is deliberately NO variable here for the Postgres connection string.
# If you need psql, read the connection string from the Supabase dashboard each
# time rather than storing it. A connection string once lived in .env.local
# under the name NEXT_PUBLIC_SUPABASE_ANON_KEY — one code reference away from
# shipping the database password to every visitor. Do not reintroduce it.


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# PUBLIC. Used for auth email redirect targets and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# PayMongo — the payment provider (https://dashboard.paymongo.com)
#
# PayMongo Checkout Sessions cover GCash, Maya, GrabPay and cards as payment
# *methods*, so this one integration gives buyers every method they expect.
# -----------------------------------------------------------------------------
# PUBLIC — client-side tokenisation only, safe to expose.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# SECRET — full API access. Server-only.
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# SECRET — from Developers → Webhooks after registering your endpoint at
# <NEXT_PUBLIC_SITE_URL>/api/webhooks/paymongo
# Without this the webhook rejects every delivery, and orders never leave
# "pending" after payment.
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxx

# "test" or "live". Selects which signature field the webhook verifies:
# PayMongo signs test deliveries as `te=` and live ones as `li=`.
PAYMONGO_ENV=test

# Dev only: set to 1 to expose an admin "simulate payment" control so the
# checkout flow can be demonstrated without a public webhook URL. Ignored when
# NODE_ENV=production. Leave unset in Vercel.
ENABLE_PAYMENT_SIMULATION=


# -----------------------------------------------------------------------------
# Brevo — transactional email (https://app.brevo.com)
#
# Uses the HTTP API v3, not SMTP: serverless functions cannot hold an SMTP
# connection across invocations, and outbound port 587 is often blocked.
# Verify your sender domain (SPF/DKIM) or mail will land in spam.
# -----------------------------------------------------------------------------
# SECRET
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=no-reply@yourdomain.ph
BREVO_SENDER_NAME=IncluMarket

# Optional SMTP fallback — only needed if you swap the HTTP client for
# nodemailer. Not used by the current code.
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# OpenRouter — support chatbot LLM (https://openrouter.ai/keys)
#
# Leave CHAT_PROVIDER empty to keep the built-in rule-based responder, which
# needs no key and no network. The widget behaves identically either way; the
# LLM path falls back to the rule-based responder on any error or timeout.
# -----------------------------------------------------------------------------
# The PROVIDER SWITCH only. Set to exactly "openrouter" to enable the LLM, or
# leave empty for the built-in rule-based responder.
#
# This is NOT where the model goes. A value like
#   CHAT_PROVIDER=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# merges the switch and the model id; the code now tolerates it and warns, but
# the model belongs in OPENROUTER_MODEL below.
CHAT_PROVIDER=

# SECRET
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Model id. Free-tier ids on OpenRouter are renamed and retired without notice,
# so this is configurable rather than hardcoded — if the model 404s, the chat
# silently falls back to the rule-based responder and logs the id server-side.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Sent as HTTP-Referer / X-Title. OpenRouter uses these for attribution and
# free-tier rate allocation.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=IncluMarket

# Cost and latency ceilings.
OPENROUTER_MAX_TOKENS=400
OPENROUTER_TIMEOUT_MS=8000


# -----------------------------------------------------------------------------
# Seed accounts — scripts/provision-users.mjs only
#
# These used to be hardcoded in the script and published in the README, six
# accounts sharing one 8-character password. Set them here instead; the script
# refuses to run without SEED_ACCOUNT_PASSWORD and rejects weak values.
# -----------------------------------------------------------------------------
# SECRET — minimum 12 characters.
SEED_ACCOUNT_PASSWORD=

SEED_ADMIN_EMAIL=admin@example.test
SEED_SELLER_EMAIL=seller@example.test
SEED_SELLER2_EMAIL=seller2@example.test
SEED_SELLER3_EMAIL=seller3@example.test
SEED_BUYER_EMAIL=buyer@example.test
SEED_BUYER2_EMAIL=buyer2@example.test

# Safety interlock: the seed script refuses to run against a non-localhost
# NEXT_PUBLIC_SITE_URL unless this is explicitly set to 1.
# ALLOW_SEED_IN_PROD=


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# SECRET — salt for hashing IP addresses in the rate-limit table. Raw IPs are
# personal data under RA 10173, so they are never stored. Use a long random
# string; changing it resets all in-flight rate-limit windows.
RATE_LIMIT_SALT=

# Set to 1 to enforce the Content-Security-Policy instead of only reporting it.
# Start unset, watch the browser console for violations, then enable.
CSP_ENFORCE=
