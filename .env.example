# InkluMarket — environment variables (safe to commit; placeholders only)
# Copy this file to `.env.local` and fill in the real values.

# ---- Public (exposed to the browser bundle) ----------------------------------
# Safe to be public. The publishable/anon key only grants access allowed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only (NEVER expose to the browser) -------------------------------
# The service role key bypasses RLS. It must ONLY be used in server components,
# route handlers, server actions, and scripts/provision-users.mjs.
# NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me...server-only

# ---- Optional -----------------------------------------------------------------
# Chatbot responder provider (see lib/chatbot/responder.ts). Unset = rule-based
# mock responder (default, no API key needed). Set once a real LLM provider is
# wired up in getChatResponder() — no UI or action-layer changes required.
# CHAT_PROVIDER=
