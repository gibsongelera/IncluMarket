# InkluMarket — environment variables (safe to commit; placeholders only)
# Copy this file to `.env.local` and fill in the real values.

# ---- Public (exposed to the browser bundle) ----------------------------------
# Safe to be public. The publishable/anon key only grants access allowed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Server-only (NEVER expose to the browser) -------------------------------
# The service role key bypasses RLS. It must ONLY be used in server components,
# route handlers, and server actions. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me...server-only

# Secret used to sign the lightweight demo session cookie.
DEMO_SESSION_SECRET=change-me-to-a-long-random-string
